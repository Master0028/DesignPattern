<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:padding="10dp"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@drawable/dialog_background1"
        android:orientation="vertical">
<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Editing permission"-->
<!--            android:textSize="23sp"-->
<!--            android:textColor="@color/black"-->
<!--            android:fontFamily="@font/itim"-->
<!--            android:paddingBottom="10dp" />-->

<!--        <Spinner-->
<!--            android:id="@+id/spinnerEditing"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content" />-->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accessing permission"
            android:textSize="23sp"
            android:layout_marginTop="20dp"
            android:textColor="@color/black"
            android:fontFamily="@font/itim"
            android:paddingBottom="10dp" />
        <Spinner
            android:id="@+id/spinnerAccessing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="30dp"
            android:gravity="center">
            <Button
                android:id="@+id/btnSave"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:text="Save"
                android:textAllCaps="false"
                android:fontFamily="@font/itim"
                android:textColor="@color/white"
                android:background="@drawable/customize_button_create" />
            <Button
                android:id="@+id/btnCancel"
                android:layout_width="100dp"
                android:layout_marginLeft="20dp"
                android:layout_height="30dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:fontFamily="@font/itim"
                android:textColor="@color/black"
                android:background="@drawable/customize_button_cancle1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>