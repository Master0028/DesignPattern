<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <androidx.cardview.widget.CardView
        android:id="@+id/overView"
        android:layout_width="360dp"
        android:layout_height="100dp"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="15dp"
        android:clickable="true"
        android:focusable="true"
        app:cardElevation="10dp"
        android:layout_gravity="center"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="10dp">
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1st time"
                android:textSize="21sp"
                android:fontFamily="@font/itim"
                android:textColor="@color/black" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed words: "
                    android:fontFamily="@font/itim"
                    android:textSize="18sp"
                    android:textColor="@color/black" />
                <TextView
                    android:id="@+id/tvCompletedWords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/30"
                    android:fontFamily="@font/itim"
                    android:textSize="18sp"
                    android:textColor="@color/black" />
                <ProgressBar
                    android:id="@+id/progressCompletedWords"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="120dp"
                    android:layout_height="8dp"
                    android:progress="40"
                    android:max="100"
                    android:layout_marginLeft="5dp"
                    android:progressDrawable="@drawable/custom_progress_bar1"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Memoried words: "
                    android:fontFamily="@font/itim"
                    android:textSize="18sp"
                    android:textColor="@color/black" />
                <TextView
                    android:id="@+id/tvMemoriedWords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25/30"
                    android:fontFamily="@font/itim"
                    android:textSize="18sp"
                    android:textColor="@color/black" />
                <ProgressBar
                    android:id="@+id/progressMemoriedWords"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="120dp"
                    android:layout_height="8dp"
                    android:progress="40"
                    android:max="100"
                    android:layout_marginLeft="10dp"
                    android:progressDrawable="@drawable/custom_progress_bar1"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>