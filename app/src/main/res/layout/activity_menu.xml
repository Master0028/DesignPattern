<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_gravity="center_vertical"
    android:background="@drawable/dialog_background"
    tools:context=".activity.MenuActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/yellow">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/itim"
            android:text="Menu"
            android:textSize="30sp" />
    </LinearLayout>

<!--    <View-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="2dp"-->
<!--        android:layout_marginHorizontal="20dp"-->
<!--        android:layout_marginTop="5dp"-->
<!--        android:background="@color/gray"-->
<!--        android:layout_gravity="center"/>-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="vertical">
                <Button
                    android:id="@+id/btnHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/baseline_home_24"
                    android:text="Home"
                    android:textAllCaps="false"
                    android:background="@drawable/ripple_effect2"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="10dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="0dp"
                    android:fontFamily="@font/itim"
                    android:textSize="22sp"
                    android:textColor="@color/black"/>
                <Button
                    android:id="@+id/btnTopics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_effect2"
                    android:text="Topics"
                    android:textAllCaps="false"
                    android:drawableLeft="@drawable/baseline_topic_24"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="0dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/itim"
                    android:drawablePadding="10dp"
                    android:textSize="22sp"
                    android:textColor="@color/black"/>
                <Button
                    android:id="@+id/btnFolders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_effect2"
                    android:drawableLeft="@drawable/baseline_folder_24"
                    android:text="Folders"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="0dp"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/itim"
                    android:textSize="22sp"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:background="@color/gray"
                    android:layout_gravity="center"/>
                <Button
                    android:id="@+id/btnFlashcard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_effect2"                    android:drawableLeft="@drawable/baseline_filter_1_24"
                    android:text="Flashcard"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="0dp"
                    android:textAllCaps="false"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/itim"
                    android:textSize="22sp"
                    android:textColor="@color/black"/>
                <Button
                    android:id="@+id/btnChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_effect2"                    android:drawableLeft="@drawable/baseline_workspaces_24"
                    android:text="Multiple Choice"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="0dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/itim"
                    android:drawablePadding="10dp"
                    android:textSize="22sp"
                    android:textColor="@color/black"/>
                <Button
                    android:id="@+id/btnFind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_effect2"                    android:drawableLeft="@drawable/baseline_search_24"
                    android:text="Find and Fill"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="0dp"
                    android:textAllCaps="false"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/itim"
                    android:textSize="22sp"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:background="@color/gray"
                    android:layout_gravity="center"/>
                <Button
                    android:id="@+id/btnCommunity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_effect2"                    android:drawableLeft="@drawable/baseline_groups_2_24"
                    android:text="Community"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="0dp"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/itim"
                    android:textSize="22sp"
                    android:textColor="@color/black"/>
                <Button
                    android:id="@+id/btnProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_effect2"                    android:drawableLeft="@drawable/baseline_person_24"
                    android:text="Profile"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="10dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/itim"
                    android:textSize="22sp"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:background="@color/gray"
                    android:layout_gravity="center"/>
                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_effect2"
                    android:drawableStart="@drawable/baseline_logout_24"
                    android:text="Logout"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="0dp"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/itim"
                    android:textSize="22sp"
                    android:textColor="@color/black"/>
                <Button
                    android:id="@+id/btnSetting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_effect2"
                    android:drawableStart="@drawable/setting"
                    android:text="Setting"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="0dp"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/itim"
                    android:textSize="22sp"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:src="@drawable/menu"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>