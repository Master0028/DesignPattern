<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="270dp"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background1"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:text="Choose study mode"
        android:textSize="23sp"
        android:layout_marginTop="10dp"
        android:textColor="@color/black"
        android:fontFamily="@font/itim"
        android:paddingBottom="10dp" />

    <Spinner
        android:id="@+id/spinnerStudyMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp"
        android:gravity="center">
        <Button
            android:id="@+id/btnStart"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:text="Start"
            android:textAllCaps="false"
            android:fontFamily="@font/itim"
            android:textColor="@color/white"
            android:background="@drawable/customize_button_create" />
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="100dp"
            android:layout_marginLeft="20dp"
            android:layout_height="30dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:fontFamily="@font/itim"
            android:textColor="@color/black"
            android:background="@drawable/customize_button_cancle1" />
    </LinearLayout>
</LinearLayout>