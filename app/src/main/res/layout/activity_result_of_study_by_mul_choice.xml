<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".activity.ResultOfStudyByMulChoiceActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/btnCancel"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/incorrect_icon"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="16dp"/>
            </RelativeLayout>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/bg_folder_detail"/>
            <TextView
                android:id="@+id/tvTopicName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="45sp"
                android:fontFamily="@font/itim"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="30dp"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:text="Topic's name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESULT"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="@font/itim"
                android:textSize="28sp"
                android:layout_gravity="center"
                android:textColor="#F37122"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You have just finished the topic, keep trying!"
                android:layout_marginHorizontal="10dp"
                android:fontFamily="@font/itim"
                android:textSize="20sp"
                android:layout_gravity="center"
                android:textColor="@color/black"/>
            <ProgressBar
                android:id="@+id/progressCompletedWords"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="350dp"
                android:layout_height="15dp"
                android:progress="70"
                android:max="100"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="5dp"
                android:progressDrawable="@drawable/custom_progress_bar1"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvCorrect"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/itim"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/black"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:background="@drawable/rounded_background1"
                        android:text="20"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:fontFamily="@font/itim"
                        android:layout_marginTop="10dp"
                        android:layout_marginHorizontal="30dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:text="Correct" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_marginLeft="70dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/itim"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/black"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:background="@drawable/rounded_background2"
                        android:text="32"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:fontFamily="@font/itim"
                        android:layout_marginTop="10dp"
                        android:layout_marginHorizontal="30dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:text="Total" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Words learned in this lesson:"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="@font/itim"
                android:textSize="22sp"
                android:textColor="#F37122"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="110dp"
                android:layout_height="40dp"
                android:text="Restart"
                android:fontFamily="@font/itim"
                android:layout_gravity="center"
                android:textSize="18sp"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="120dp"
                android:layout_marginBottom="20dp"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:background="@drawable/rounded_btn6"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:src="@drawable/btnhome" />

        <ImageButton
            android:id="@+id/btnTopics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:src="@drawable/btntopic" />

        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:src="@drawable/btnadd" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:src="@drawable/btnprofile" />

        <ImageButton
            android:id="@+id/btnCommunity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:background="@null"
            android:src="@drawable/btncommunity" />
    </LinearLayout>
</LinearLayout>