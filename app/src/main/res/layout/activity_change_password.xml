<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ChangePasswordActivity">

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:src="@drawable/bg_changepassword"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Password"
        android:fontFamily="@font/itim"
        android:layout_gravity="center"
        android:textSize="26sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Complex password to protect"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="18sp"
        android:layout_marginHorizontal="40dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current password"
        android:fontFamily="@font/itim"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="30dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="25dp">

        <EditText
            android:id="@+id/currentPass"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/edit_text_border"
            android:padding="15dp"
            android:drawableStart="@drawable/baseline_lock_24"
            android:fontFamily="@font/itim"
            android:hint="Enter current password"
            android:inputType="textPassword"/>

        <ImageView
            android:id="@+id/currentPassEye"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:src="@drawable/baseline_remove_red_eye_24"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Password"
            android:fontFamily="@font/itim"
            android:textSize="20sp"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="30dp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="25dp">

        <EditText
            android:id="@+id/newPass"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/edit_text_border"
            android:padding="15dp"
            android:drawableStart="@drawable/baseline_lock_24"
            android:fontFamily="@font/itim"
            android:hint="Enter new password"
            android:inputType="textPassword"/>

        <ImageView
            android:id="@+id/newPassEye"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:src="@drawable/baseline_remove_red_eye_24"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Re Type New Password"
        android:fontFamily="@font/itim"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="30dp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="25dp">

        <EditText
            android:id="@+id/reTypeNewPass"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/edit_text_border"
            android:padding="15dp"
            android:drawableStart="@drawable/baseline_lock_24"
            android:fontFamily="@font/itim"
            android:hint="Re enter new password"
            android:inputType="textPassword"/>

        <ImageView
            android:id="@+id/recurrentPassEye"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:src="@drawable/baseline_remove_red_eye_24"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <Button
        android:id="@+id/changePass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Change Password"
        android:textSize="22sp"
        android:fontFamily="@font/itim"
        android:background="@drawable/radius_btn"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="35dp"
        android:paddingVertical="20dp"/>
</LinearLayout>